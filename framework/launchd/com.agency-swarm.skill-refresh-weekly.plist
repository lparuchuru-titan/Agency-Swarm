    <key>StandardOutPath</key>
    <string>/path/to/your-sfdx-project/tools/sfdc-knowledge-swarm/skill-refresh-weekly.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/path/to/your-sfdx-project/tools/sfdc-knowledge-swarm/skill-refresh-weekly.launchd.err.log</string>
